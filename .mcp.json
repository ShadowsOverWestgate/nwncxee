{
  "mcpServers": {
    "plane": {
      "command": "uvx",
      "args": [
        "plane-mcp-server",
        "stdio"
      ],
      "env": {
        "PLANE_BASE_URL": "https://plane.westgate.pw",
        "PLANE_WORKSPACE_SLUG": "shadows-over-westgate",
        "PLANE_API_KEY": "${PLANE_API_KEY}"
      }
    }
  }
}
