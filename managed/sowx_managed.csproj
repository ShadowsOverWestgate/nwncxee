<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>sowx_managed</AssemblyName>
    <!-- CI overrides with `dotnet publish -r win-x64`; NativeAOT needs a Windows
         toolchain to emit the .dll, so the Windows leg runs on a Windows runner. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep the symbol table in the .so: a NativeAOT crash report is a list of module offsets, and
         without this addr2line resolves every one of them to the nearest EXPORT (i.e. SowxInit) and the
         backtrace says nothing. Costs size in a file nobody ships to players. -->
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <!-- Keep our own assembly whole: the service host discovers services by
       reflection, so their constructors must survive trimming. Trimming a tiny
       extender saves nothing; rooting it removes all reflection/AOT fragility. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="sowx_managed" />
  </ItemGroup>

</Project>
