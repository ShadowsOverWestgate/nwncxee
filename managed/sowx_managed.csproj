<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>sowx_managed</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
  </ItemGroup>

  <!-- Keep our own assembly whole: the service host discovers services by
       reflection, so their constructors must survive trimming. Trimming a tiny
       extender saves nothing; rooting it removes all reflection/AOT fragility. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="sowx_managed" />
  </ItemGroup>

</Project>
